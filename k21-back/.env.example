NODE_ENV=development
PORT=3100

# Supabase → botón "Connect" del proyecto.
# App: Transaction pooler (puerto 6543).
DATABASE_URL="postgresql://postgres.REF_PROYECTO:CLAVE@aws-0-REGION.pooler.supabase.com:6543/postgres"
# Migraciones (prisma migrate): Session pooler (puerto 5432) o conexión directa.
DIRECT_URL="postgresql://postgres.REF_PROYECTO:CLAVE@aws-0-REGION.pooler.supabase.com:5432/postgres"
DATABASE_SSL=true
# Opcional: certificado CA de Supabase (Project Settings → Database → SSL) para verificar el servidor
# DATABASE_CA_CERT=./prod-ca-2021.crt
DATABASE_POOL_MAX=5

CORS_ORIGIN=http://localhost:5173
# Mínimo 32 caracteres
JWT_SECRET=
# Administrador inicial que crea `npm run seed` (solo si no existe)
ADMIN_USUARIO=admin
ADMIN_CONTRASENHA=cambiar123
